{
  "name": "discord-bot-fleet",
  "version": "1.0.0",
  "description": "Multi-bot Discord fleet with web control panel — designed for HuggingFace Space deployment",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "bot": "tsx src/bot.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "express": "^4.21.1",
    "ws": "^8.18.0",
    "openai": "^4.73.0",
    "node-cron": "^3.0.3",
    "nanoid": "^5.0.8",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@types/node": "^22.9.0",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.13",
    "@types/node-cron": "^3.0.11"
  },
  "engines": {
    "node": ">=20"
  }
}
